# =============================================================================
# Example Terraform variables for OMCSI on an existing Kubernetes cluster
# =============================================================================
# Copy this file to terraform.tfvars and fill in the values.
#   cp terraform.tfvars.example terraform.tfvars
#
# Alternatively, pass values via -var flags:
#   terraform apply -var rcon_password=changeme -var admin_password=strongpass
# =============================================================================

# Path to your kubeconfig file (default: ~/.kube/config)
# kubeconfig_path = "~/.kube/config"

# Context to use from the kubeconfig (default: current-context)
# kubeconfig_context = "my-cluster-context"

# OMCSI secrets (required)
rcon_password  = "changeme"
admin_password = "strongpassword"

# Container image registry – defaults to "dmccoystephenson" (Docker Hub).
# Override if you host images in a private registry.
# image_registry = "dmccoystephenson"

# StorageClass for PVCs — leave empty to use the cluster default. Override
# if your cluster requires a specific class.
# storage_class = ""

# Optional: Discord alerts (alert-manager)
# Setting discord_webhook_url automatically enables Discord in alert-manager.
# discord_webhook_url = "https://discord.com/api/webhooks/..."

# Optional: plugin hot-deploy bearer token (POST /api/plugins/deploy)
# deploy_auth_token = "your-secret-token"

# Optional: agent-manager (Discord AI bot)
# agent_manager_enabled    = true
# agent_discord_bot_token  = "BOT_TOKEN"
# agent_discord_channel_id = "CHANNEL_ID"
# agent_anthropic_api_key  = "API_KEY"

# Optional: custom Helm values file
# Use this to override any Helm chart value not exposed as a Terraform variable
# (e.g., MOTD, operator UUID, resource limits, TLS settings).
# helm_values_file = "/absolute/path/to/my-values.yaml"
