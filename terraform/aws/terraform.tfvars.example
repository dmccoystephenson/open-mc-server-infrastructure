# =============================================================================
# Example Terraform variables for OMCSI on AWS Elastic Kubernetes Service (EKS)
# =============================================================================
# Copy this file to terraform.tfvars and fill in the values.
#   cp terraform.tfvars.example terraform.tfvars
#
# AWS credentials are read from the standard AWS CLI configuration
# (~/.aws/credentials) or environment variables (AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY). Run `aws configure` if you have not set these up.
# =============================================================================

# AWS region
aws_region = "us-east-1"

# Cluster settings
cluster_name       = "omcsi"
cluster_version    = "1.34"            # See https://docs.aws.amazon.com/eks/latest/userguide/kubernetes-versions.html
node_instance_type = "t3.large"       # 2 vCPU, 8 GB RAM
node_desired_count = 2
node_min_count     = 1
node_max_count     = 4

# EKS API endpoint access — restrict to your IP / CIDR for security.
# Default is ["0.0.0.0/0"] (open to all); narrow this in production.
# eks_public_access_cidrs = ["203.0.113.0/24"]

# OMCSI secrets (required)
rcon_password  = "changeme"
admin_password = "strongpassword"

# Container image registry – defaults to "dmccoystephenson" (Docker Hub).
# Override if you host images in a private registry or ECR.
# Example: "123456789.dkr.ecr.us-east-1.amazonaws.com/omcsi" for ECR.
# image_registry = "dmccoystephenson"

# StorageClass for PVCs — defaults to "gp2" (AWS EBS). Override if your
# cluster uses a different StorageClass (e.g., "gp3", "io1").
# storage_class = "gp2"

# Optional: Discord alerts (alert-manager)
# Setting discord_webhook_url automatically enables Discord in alert-manager.
# discord_webhook_url = "https://discord.com/api/webhooks/..."

# Optional: plugin hot-deploy bearer token (POST /api/plugins/deploy)
# deploy_auth_token = "your-secret-token"

# Optional: agent-manager (Discord AI bot)
# agent_manager_enabled    = true
# agent_discord_bot_token  = "BOT_TOKEN"
# agent_discord_channel_id = "CHANNEL_ID"
# agent_anthropic_api_key  = "API_KEY"

# Optional: custom Helm values file
# Use this to override any Helm chart value not exposed as a Terraform variable
# (e.g., MOTD, operator UUID, resource limits, TLS settings).
# helm_values_file = "/absolute/path/to/my-values.yaml"
