# =============================================================================
# Example Terraform variables for OMCSI on AWS Elastic Kubernetes Service (EKS)
# =============================================================================
# Copy this file to terraform.tfvars and fill in the values.
#   cp terraform.tfvars.example terraform.tfvars
#
# AWS credentials are read from the standard AWS CLI configuration
# (~/.aws/credentials) or environment variables (AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY). Run `aws configure` if you have not set these up.
# =============================================================================

# AWS region
aws_region = "us-east-1"

# Cluster settings
cluster_name       = "omcsi"
cluster_version    = "1.31"
node_instance_type = "t3.large"       # 2 vCPU, 8 GB RAM
node_desired_count = 2
node_min_count     = 1
node_max_count     = 4

# OMCSI secrets (required)
rcon_password  = "changeme"
admin_password = "strongpassword"

# Optional: agent-manager (Discord AI bot)
# agent_manager_enabled    = true
# agent_discord_bot_token  = "BOT_TOKEN"
# agent_discord_channel_id = "CHANNEL_ID"
# agent_anthropic_api_key  = "API_KEY"

# Optional: custom Helm values file
# helm_values_file = "my-values.yaml"
